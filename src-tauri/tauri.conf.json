{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InSitu",
  "identifier": "com.luminariste.insitu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "InSitu",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    },
    "resources": {
      "../jeu-essai/epinal/references/verres/*.png": "jeu-essai/epinal/references/verres/",
      "../jeu-essai/epinal/references/photos-redressees/*.jpg": "jeu-essai/epinal/references/photos-redressees/"
    }
  }
}
